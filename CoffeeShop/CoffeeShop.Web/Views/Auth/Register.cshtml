@model RegistrationRequestDto
@using CoffeeShop.Web.Utility
@{
    ViewData["Title"] = "Реєстрація";
}
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="text-white">Реєстрація</h1>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <div class="row">
                <div class="col-12 col-md-6 offset-md-3 pb-2">
                    <input asp-for="Email" class="form-control" placeholder="Email..." />
                    <span asp-validation-for="Email" class="text-danger" />
                </div>
                <div class="col-12 col-md-6 offset-md-3 pb-2">
                    <input asp-for="Name" class="form-control" placeholder="Ім'я..." />
                    <span asp-validation-for="Name" class="text-danger" />
                </div>
                <div class="col-12 col-md-6 offset-md-3 pb-2">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Номер телефону..." />
                    <span asp-validation-for="PhoneNumber" class="text-danger" />
                </div>
                <div class="col-12 col-md-6 offset-md-3 pb-2">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Пароль..." />
                    <span asp-validation-for="Password" class="text-danger" />
                </div>
                @if (User.IsInRole(SD.RoleAdmin))
                {
                    <div class="col-12 col-md-6 offset-md-3 pb-2">
                        <select asp-for="Role" class="form-select" asp-items="@ViewBag.RoleList">
                            <option disabled selected>--Select Role--</option>
                        </select>
                    </div>
                }

                <div class="col-12 col-md-6 offset-md-3 pb-2">
                    <button type="submit" class="form-control btn btn-success" value="Submit">Зареєструватися</button>
                </div>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
