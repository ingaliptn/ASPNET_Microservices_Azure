@model ProductDto
@{
    ViewData["Title"] = "Видалення продукту";
}


<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="text-white">Видалення продукту</h1>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="ProductDelete">
            <input asp-for="ProductId" hidden />
            <div class="row">
                <div class="col-2">
                    <label class="control-label pt-2 text-dark" style="font-size:20px;">Назва</label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="Name" disabled class="form-control" />
                </div>
                <div class="col-2">
                    <label class="control-label pt-2 text-dark" style="font-size:20px;">Категорія</label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="CategoryName" disabled class="form-control" />
                </div>
                <div class="col-2">
                    <label class="control-label pt-2 text-dark" style="font-size:20px;">Опис</label>
                </div>
                <div class="col-10 pb-3">
                    <textarea asp-for="Description" disabled class="form-control" rows="5"></textarea>
                </div>

                <div class="col-2">
                    <label class="control-label pt-2 text-dark" style="font-size:20px;">Ціна</label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="Price" disabled class="form-control" />
                </div>
                <div class="col-2">
                    <label class="control-label pt-2 text-dark" style="font-size:20px;">Url картинки</label>
                </div>
                <div class="col-10 pb-3">
                    <input asp-for="ImageUrl" disabled class="form-control" />
                </div>

                <div class="col-5 offset-2">

                    <a asp-action="ProductIndex" class="btn-primary btn form-control ">Повернутися до списку</a>
                </div>
                <div class="col-5">
                    <input type="submit" value="Видалити" class="btn btn-danger form-control" />

                </div>

            </div>

        </form>
    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
