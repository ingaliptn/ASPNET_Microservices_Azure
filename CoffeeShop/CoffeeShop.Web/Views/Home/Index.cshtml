@model IEnumerable<ProductDto>
@{
    ViewData["Title"] = "Головна";
}
@using System.Globalization;

<br />
<h1 class="text-center text-primary ">Магазин CoffeeShop вітає тебе!</h1>
<br />
<form>
    <div class="container row">

        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="p-0 my-3 border rounded">
                    <div class="card">
                        <h3 class="card-title text-dark-30 text-center py-2">@item.Name</h3>
                        <a asp-action="ProductDetails" asp-route-productId="@item.ProductId"><img src="@item.ImageUrl" width="100%" height="350" class="card-img-top"></a>
                        <div class="card-body">
                            <div class="d-flex justify-content-between py-2">
                                <span class="text-warning" style="font-size:20px;">@string.Format(new CultureInfo("uk-UA"), "{0:c}", item.Price)</span>
                                <span class="badge bg-info text-dark p-2">@item.CategoryName</span>
                            </div>
                            <p class="card-text">@Html.Raw(item.Description)</p>
                            <div class="row">
                                <div class="col">
                                    <a asp-action="ProductDetails" asp-route-productId="@item.ProductId" class="btn btn-success form-control">Детальніше</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</form>
